# SafeRest360 Environment Configuration
# Copy to .env and fill in values

# Backend
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite+aiosqlite:///./saferest360.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/saferest360
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional, for async tasks)
# REDIS_URL=redis://localhost:6379/0

# Messaging: telegram (default), whatsapp (legacy), disabled
NOTIFICATION_CHANNEL=telegram
TELEGRAM_TEST_MODE=true
# TELEGRAM_BOT_TOKEN=
# chat_id is saved per admin via PATCH /api/v1/users/{id}; never put the token in the frontend.

# WhatsApp legacy client; real proactive alerts still require approved templates.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_MODE=true

# Vision Engine
VISION_MODEL_PATH=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.5
VISION_DEVICE=cpu

# MLflow
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# Cloud Storage (for snapshots)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=saferest360-snapshots
SNAPSHOT_STORAGE=local
SNAPSHOT_LOCAL_PATH=./snapshots
